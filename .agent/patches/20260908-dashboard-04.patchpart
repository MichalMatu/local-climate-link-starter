+    return <AutomationDashboardScreen onAddAutomation={() => setView('intent')} />;
   }
 
   return (
     <Suspense fallback={<RouteFallback />}>
-      <HardwareSetupScreen
-        setupIntent={setupIntent}
-        onBackToIntent={() => setSetupIntent(null)}
