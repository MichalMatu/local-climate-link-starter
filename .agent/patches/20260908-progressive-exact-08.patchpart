+  padding: var(--lcl-spacing-md);
+}
+
+.rule-progressive-disclosure--developer {
+  background: var(--lcl-color-surface-muted);
+}
+
+.rule-developer-actions {
+  justify-content: flex-start;
+}
+
+.rule-developer-actions .secondary-action {
+  align-items: center;
+  display: inline-flex;
+  gap: var(--lcl-spacing-xs);
+}
+
+.rule-developer-actions .icon-action__svg {
