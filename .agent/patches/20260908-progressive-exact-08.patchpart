+
+.rule-progressive-disclosure-stack {
+  display: grid;
+  gap: var(--lcl-spacing-sm);
+}
+
+.rule-progressive-disclosure {
+  border: var(--lcl-border-width-sm) solid var(--lcl-color-border);
+  border-radius: var(--lcl-radius-md);
+  overflow: hidden;
+}
+
+.rule-progressive-disclosure > summary {
+  cursor: pointer;
+  font-weight: 800;
