+.intent-shell {
+  align-content: center;
+}
+
+.intent-header {
+  max-width: var(--lcl-size-prose-max-width);
+}
+
+.intent-choice-grid {
+  display: grid;
+  gap: var(--lcl-spacing-md);
+  grid-template-columns: repeat(
+    auto-fit,
+    minmax(min(100%, var(--lcl-size-card-column-min)), 1fr)
+  );
+}
+
+.intent-choice {
+  background: var(--lcl-color-surface);
+  border: var(--lcl-border-width-sm) solid var(--lcl-color-border);
+  border-radius: var(--lcl-radius-lg);
+  box-shadow: var(--lcl-shadow-md);
+  color: var(--lcl-color-text);
+  cursor: pointer;
+  display: grid;
+  gap: var(--lcl-spacing-sm);
+  padding: var(--lcl-fluid-panel-padding);
+  text-align: left;
+}
+
+.intent-choice:hover,
+.intent-choice:focus-visible {
+  border-color: var(--lcl-color-accent);
+}
+
+.intent-choice strong {
+  font-size: var(--lcl-font-size-xl);
+  line-height: var(--lcl-line-height-tight);
+}
+
+.intent-choice span {
+  color: var(--lcl-color-text-muted);
+  line-height: var(--lcl-line-height-relaxed);
+}
+
+.intent-choice .intent-choice__action {
+  color: var(--lcl-color-accent);
+  font-size: var(--lcl-font-size-sm);
+  font-weight: 800;
+  margin-top: var(--lcl-spacing-sm);
+}
+
+.setup-context {
+  align-items: center;
+  display: flex;
+  gap: var(--lcl-spacing-md);
+  justify-content: space-between;
+}
+
+.setup-context__back {
+  background: transparent;
+  flex: 0 0 auto;
+  border: 0;
+  color: var(--lcl-color-accent);
+  cursor: pointer;
+  font-weight: 800;
+  padding: var(--lcl-spacing-sm) 0;
+}
+
+.setup-context strong {
+  color: var(--lcl-color-text-muted);
+  font-size: var(--lcl-font-size-sm);
+  min-width: 0;
+  overflow-wrap: anywhere;
+  text-align: right;
+}
