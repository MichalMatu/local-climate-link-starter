+      ...base,
+      sensor: {
+        ...base.sensor,
+        runtimeAddress: 'A4:C1:38:4F:24:CD',
+        displayName: 'Przedpokój'
+      }
+    },
+    nowMs: 1000
+  });
+};
+
+const diagnosticPayload = () => ({
