{
  "id": "20260909-disk-diagnose-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/android-toolchain-preflight-v1",
  "allow_write": false,
  "resources": [],
  "memory_limit_mb": 1024,
  "command_timeout": 300,
  "idle_timeout": 120,
  "task_timeout": 600,
  "commands": [
    "df -h / \"$HOME\"; df -i / \"$HOME\"",
    "du -sh \"$HOME/Library/Android/sdk\" \"$HOME/.gradle\" \"$HOME/Library/Caches\" \"$HOME/.cache\" \"$HOME/agent-workspace\" \"$HOME/local-agent\" 2>/dev/null | sort -h || true",
    "du -sh \"$HOME/Library/Android/sdk/system-images\"/*/*/* \"$HOME/Library/Android/sdk/emulator\" \"$HOME/Library/Android/sdk/platforms\" \"$HOME/Library/Android/sdk/build-tools\" 2>/dev/null | sort -h || true",
    "du -sh \"$HOME/.gradle/caches\"/* \"$HOME/.gradle/wrapper\"/* 2>/dev/null | sort -h | tail -30 || true"
  ]
}
