{
  "id": "20260909-installation-health-recovery-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/installation-health-recovery-v1",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 4096,
  "command_timeout": 1800,
  "idle_timeout": 600,
  "task_timeout": 3600,
  "commands": [
    "git fetch --prune origin",
    "test \"$(git rev-parse origin/main)\" = \"0e40e06ae82a5b7c035c7503086a87e81f2f1e4a\"",
    "git checkout -B work/installation-health-recovery-v1 origin/work/installation-health-recovery-v1 && git reset --hard origin/work/installation-health-recovery-v1 && git clean -fd",
    "printf '%s' '' | base64 -d | gzip -d | python3",
    "pnpm exec prettier --write apps/mobile/src/flows/installations/healthRecovery.ts apps/mobile/src/flows/installations/healthRecovery.test.ts apps/mobile/src/app/locales/installationHealth.ts apps/mobile/src/screens/InstallationDetailScreen.tsx apps/mobile/src/__tests__/automation-detail.test.tsx",
    "git diff --check",
    "test -z \"$(git diff --name-only -- packages/automation-core packages/script-generator)\"",
    "pnpm --filter @lcl/mobile exec vitest run src/flows/installations/healthRecovery.test.ts src/__tests__/automation-detail.test.tsx",
    "git add apps/mobile/src/flows/installations/healthRecovery.ts apps/mobile/src/flows/installations/healthRecovery.test.ts apps/mobile/src/app/locales/installationHealth.ts apps/mobile/src/screens/InstallationDetailScreen.tsx apps/mobile/src/__tests__/automation-detail.test.tsx && git diff --cached --check",
    "git commit -m 'Add installation health recovery guidance'",
    "git push origin work/installation-health-recovery-v1",
    "printf 'COMMIT_SHA=%s\\n' \"$(git rev-parse HEAD)\" && test -z \"$(git status --porcelain)\""
  ]
}
