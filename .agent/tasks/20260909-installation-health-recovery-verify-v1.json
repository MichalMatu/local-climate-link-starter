{
  "id": "20260909-installation-health-recovery-verify-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/installation-health-recovery-v1",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 4096,
  "command_timeout": 1800,
  "idle_timeout": 600,
  "task_timeout": 3600,
  "commands": [
    "git fetch --prune origin",
    "test \"$(git rev-parse origin/main)\" = \"0e40e06ae82a5b7c035c7503086a87e81f2f1e4a\"",
    "test \"$(git rev-parse origin/work/installation-health-recovery-v1)\" = \"d424d6ca25e1197d47103c68b06746a71b6c4547\"",
    "git checkout -B work/installation-health-recovery-v1 origin/work/installation-health-recovery-v1 && git reset --hard origin/work/installation-health-recovery-v1 && git clean -fd",
    "test -z \"$(git diff --name-only origin/main...HEAD -- packages/automation-core packages/script-generator)\"",
    "git diff --check origin/main...HEAD",
    "pnpm check:full",
    "printf 'COMMIT_SHA=%s\\n' \"$(git rev-parse HEAD)\"",
    "test -z \"$(git status --porcelain)\""
  ]
}
