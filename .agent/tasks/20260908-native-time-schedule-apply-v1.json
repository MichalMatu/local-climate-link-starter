{
  "id": "20260908-native-time-schedule-apply-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/native-time-schedule",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 1024,
  "command_timeout": 180,
  "idle_timeout": 90,
  "task_timeout": 600,
  "commands": [
    "git fetch --prune origin",
    "test \"$(git rev-parse origin/work/native-time-schedule)\" = \"f92691b0f33d275510f1e22339c08bd2c9d1d7cb\"",
    "git checkout -B work/native-time-schedule origin/work/native-time-schedule",
    "git reset --hard origin/work/native-time-schedule && git clean -fd",
    "rm -f /tmp/lcl-native-schedule.patch.zst.b64 /tmp/lcl-native-schedule.patch.zst /tmp/lcl-native-schedule.patch && for i in 00 01 02 03; do git show origin/agent-control:.agent/patches/20260908-native-schedule-zst-b64-${i}.part >> /tmp/lcl-native-schedule.patch.zst.b64; done",
    "test \"$(sha256sum /tmp/lcl-native-schedule.patch.zst.b64 | awk '{print $1}')\" = \"3d84af85888505c3f056c31e31176733528156ddd03c639a769b2d7c62ddbc10\"",
    "/usr/bin/base64 -D /tmp/lcl-native-schedule.patch.zst.b64 > /tmp/lcl-native-schedule.patch.zst",
    "test \"$(sha256sum /tmp/lcl-native-schedule.patch.zst | awk '{print $1}')\" = \"198775eb204b6d9182f638bcbced64007372850ed8f1cdd1f56f70e40d9aac06\"",
    "command -v zstd >/dev/null && zstd -q -d -f /tmp/lcl-native-schedule.patch.zst -o /tmp/lcl-native-schedule.patch",
    "test \"$(sha256sum /tmp/lcl-native-schedule.patch | awk '{print $1}')\" = \"ad75af26820ae541b7b07227ec7f479676911ce8ab128740504c3649b020cdb2\"",
    "git apply --check /tmp/lcl-native-schedule.patch && git apply /tmp/lcl-native-schedule.patch",
    "git diff --check",
    "git add -A apps/mobile packages/shelly-client",
    "test \"$(git diff --cached --binary | sha256sum | awk '{print $1}')\" = \"ad75af26820ae541b7b07227ec7f479676911ce8ab128740504c3649b020cdb2\"",
    "git status --short",
    "git commit -m 'Add native daily time automation'",
    "git push origin work/native-time-schedule",
    "printf 'COMMIT_SHA=%s\\n' \"$(git rev-parse HEAD)\" && test -z \"$(git status --porcelain)\""
  ]
}
