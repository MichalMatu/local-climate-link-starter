{
  "id": "20260908-shelly-led-format-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/shelly-led-settings",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 1024,
  "command_timeout": 180,
  "idle_timeout": 90,
  "task_timeout": 600,
  "commands": [
    "git fetch --prune origin",
    "git checkout work/shelly-led-settings",
    "git pull --ff-only origin work/shelly-led-settings",
    "test \"$(git rev-parse HEAD)\" = \"67fae24a3e2a02f286055b3106c7847eb91268ea\"",
    "pnpm exec prettier --write apps/mobile/e2e/led-settings.spec.ts apps/mobile/src/__tests__/shelly-led-settings.test.tsx apps/mobile/src/screens/ShellyLedSettingsCard.tsx",
    "git diff --check",
    "test \"$(git diff --name-only | sort)\" = \"apps/mobile/e2e/led-settings.spec.ts\napps/mobile/src/__tests__/shelly-led-settings.test.tsx\napps/mobile/src/screens/ShellyLedSettingsCard.tsx\"",
    "git add apps/mobile/e2e/led-settings.spec.ts apps/mobile/src/__tests__/shelly-led-settings.test.tsx apps/mobile/src/screens/ShellyLedSettingsCard.tsx",
    "git commit -m 'Format Shelly LED settings tests and UI'",
    "git push origin work/shelly-led-settings",
    "git status --short"
  ]
}
