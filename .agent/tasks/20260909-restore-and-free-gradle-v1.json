{
  "id": "20260909-restore-and-free-gradle-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/android-toolchain-preflight-v1",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 1024,
  "command_timeout": 900,
  "idle_timeout": 300,
  "task_timeout": 1800,
  "commands": [
    "git fetch --prune origin && test \"$(git rev-parse origin/work/android-toolchain-preflight-v1)\" = \"8c93be488f1740ef3a4c2ef3c2201da0991f36ff\"",
    "git checkout -B work/android-toolchain-preflight-v1 origin/work/android-toolchain-preflight-v1 && git reset --hard origin/work/android-toolchain-preflight-v1 && git clean -fd",
    "test -z \"$(git status --porcelain)\"",
    "rm -rf \"$HOME/.gradle/caches\" \"$HOME/.gradle/daemon\" \"$HOME/.gradle/native\" \"$HOME/.gradle/notifications\"",
    "df -h / \"$HOME\" && du -sh \"$HOME/.gradle\" \"$HOME/Library/Android/sdk\" \"$HOME/agent-workspace/repos/local-climate-link-starter\" 2>/dev/null || true",
    "test -z \"$(git status --porcelain)\""
  ]
}