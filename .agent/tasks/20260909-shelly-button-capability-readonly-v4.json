    "printf '%s\\n' '=== Button.GetStatus id=0 ==='; curl -sS --max-time 5 --get --data-urlencode 'id=0' 'http://192.168.0.16/rpc/Button.GetStatus'",
    "printf '%s\\n' '=== Switch.GetConfig id=0 ==='; curl -sS --max-time 5 --get --data-urlencode 'id=0' 'http://192.168.0.16/rpc/Switch.GetConfig'",
    "printf '%s\\n' '=== PLUGS_UI.GetConfig ==='; curl -sS --max-time 5 'http://192.168.0.16/rpc/PLUGS_UI.GetConfig'",
    "printf '%s\\n' '=== Script.List ==='; curl -sS --max-time 5 'http://192.168.0.16/rpc/Script.List'"
