{
  "id": "20260909-shelly-button-capability-readonly-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "main",
  "allow_write": false,
  "resources": [],
  "memory_limit_mb": 512,
  "command_timeout": 60,
  "idle_timeout": 60,
  "task_timeout": 300,
  "commands": [
    "git fetch origin main && git checkout --detach origin/main && test \"$(git rev-parse HEAD)\" = \"3e98ed7a28221ef820aca7a814cb1ac03d951b2c\"",
    "printf '%s\\n' '=== route ==='; route -n get 192.168.0.20 2>&1 || true; printf '%s\\n' '=== arp ==='; arp -an | grep -F '192.168.0.20' || true",
    "printf '%s\\n' '=== Shelly.GetDeviceInfo ==='; curl -sS --max-time 5 'http://192.168.0.20/rpc/Shelly.GetDeviceInfo' 2>&1 || true",
    "printf '%s\\n' '=== Shelly.ListMethods ==='; curl -sS --max-time 5 'http://192.168.0.20/rpc/Shelly.ListMethods' 2>&1 || true",
    "printf '%s\\n' '=== Shelly.GetStatus ==='; curl -sS --max-time 5 'http://192.168.0.20/rpc/Shelly.GetStatus' 2>&1 || true",
    "printf '%s\\n' '=== PLUGS_UI.GetConfig ==='; curl -sS --max-time 5 'http://192.168.0.20/rpc/PLUGS_UI.GetConfig' 2>&1 || true"
  ]
}