{
  "id": "20260908-progressive-disclosure-apply-v1",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/progressive-disclosure",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 1024,
  "command_timeout": 180,
  "idle_timeout": 90,
  "task_timeout": 600,
  "commands": [
    "git fetch --prune origin",
    "test \"$(git rev-parse origin/work/progressive-disclosure)\" = \"1c6af16f1926fb993c59d9905860e5cb1c57b112\"",
    "git checkout -B work/progressive-disclosure origin/work/progressive-disclosure",
    "git reset --hard origin/work/progressive-disclosure && git clean -fd",
    "rm -f /tmp/lcl-progressive.patch && for i in 00 01 02 03 04 05 06 07 08 09; do git show origin/agent-control:.agent/patches/20260908-progressive-exact-${i}.patchpart >> /tmp/lcl-progressive.patch; done",
    "test \"$(sha256sum /tmp/lcl-progressive.patch | awk '{print $1}')\" = \"1ead4034ff8acc9935396e158e1ef1e6105b8cd4559167832bd4031138733bd1\"",
    "git apply --check /tmp/lcl-progressive.patch && git apply /tmp/lcl-progressive.patch",
    "git diff --check",
    "git add apps/mobile",
    "test \"$(git diff --cached --binary | sha256sum | awk '{print $1}')\" = \"1ead4034ff8acc9935396e158e1ef1e6105b8cd4559167832bd4031138733bd1\"",
    "git status --short",
    "git commit -m 'Hide advanced and developer controls by default'",
    "git push origin work/progressive-disclosure",
    "printf 'COMMIT_SHA=%s\\n' \"$(git rev-parse HEAD)\" && test -z \"$(git status --porcelain)\""
  ]
}
