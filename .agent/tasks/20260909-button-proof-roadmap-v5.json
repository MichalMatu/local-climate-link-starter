{
  "id": "20260909-button-proof-roadmap-v5",
  "agent_binding": "e75c77cb-7589-4452-94b2-decc97ff85a1",
  "mode": "commands",
  "work_branch": "work/installation-health-recovery",
  "allow_write": true,
  "resources": [],
  "memory_limit_mb": 4096,
  "command_timeout": 900,
  "idle_timeout": 300,
  "task_timeout": 1800,
  "commands": [
    "git fetch --prune origin",
    "test $(git rev-parse origin/main) = 186ed0f74d51ba79f5a6f43bb4c66ac5e56be239",
    "git checkout -B work/installation-health-recovery origin/work/installation-health-recovery",
    "git reset --hard origin/work/installation-health-recovery && git clean -fd",
    "test $(git rev-parse HEAD) = 186ed0f74d51ba79f5a6f43bb4c66ac5e56be239",
    "printf '%s' '' | base64 -d > /tmp/button-section.md",
    "python3 - <<'PY'\nfrom pathlib import Path\np = Path('docs/product/next-functional-steps.md')\ns = p.read_text()\nstart = s.index('### Button — hardware validation complete\\n')\nend = s.index('\\n## 6. Dedicated screen for every Shelly / installed system', start)\nreplacement = Path('/tmp/button-section.md').read_text()\np.write_text(s[:start] + replacement + s[end:])\nPY",
    "git diff --check",
    "test $(git diff --name-only) = docs/product/next-functional-steps.md",
    "pnpm exec prettier --check docs/product/next-functional-steps.md",
    "git add docs/product/next-functional-steps.md && git diff --cached --check",
    "git commit -m 'Record Plug S Gen3 button hardware proof'",
    "git push origin work/installation-health-recovery",
    "git rev-parse HEAD",
    "test -z $(git status --porcelain)"
  ]
}
