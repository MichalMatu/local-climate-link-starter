{
  "name": "local-climate-link-starter",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --filter @lcl/mobile dev",
    "dev:landing": "pnpm --filter @lcl/landing dev",
    "build": "pnpm -r build",
    "build:landing": "pnpm --filter @lcl/landing build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage:core": "pnpm --filter @lcl/automation-core test:coverage && pnpm --filter @lcl/script-generator test:coverage",
    "test:watch": "pnpm -r test -- --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged && pnpm quality:ux",
    "prepush": "pnpm check",
    "prepare": "husky",
    "quality:ux": "node scripts/quality/ux-gate.mjs",
    "e2e:responsive": "playwright test -c apps/mobile/playwright.config.ts",
    "tokens:build": "pnpm --filter @lcl/design-tokens build",
    "hardware:shelly:install": "tsx scripts/hardware/shelly-install-thermostat.ts",
    "hardware:shelly:matrix": "tsx scripts/hardware/shelly-real-matrix.ts",
    "hardware:shelly:soak": "tsx scripts/hardware/shelly-soak-logger.ts",
    "check": "pnpm format:check && pnpm lint && pnpm quality:ux && pnpm typecheck && pnpm test && pnpm test:coverage:core && pnpm build",
    "check:full": "pnpm check && pnpm e2e:responsive"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@lcl/automation-core": "workspace:*",
    "@lcl/script-generator": "workspace:*",
    "@lcl/shelly-client": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
