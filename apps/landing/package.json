{
  "name": "@lcl/landing",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format:check": "prettier --check README.md index.html package.json tsconfig*.json vite.config.ts vitest.config.ts src",
    "quality:ux": "pnpm --dir ../.. quality:ux",
    "check": "pnpm format:check && pnpm lint && pnpm quality:ux && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@lcl/design-tokens": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
